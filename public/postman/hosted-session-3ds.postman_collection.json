    {
      "name": "Update Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json = pm.response.json();\r",
              "\r",
              "\r",
              "if (json.order && json.order.id) {\r",
              "\r",
              "    let orderId = json.order.id;\r",
              "\r",
              "    postman.setEnvironmentVariable('orderId', orderId);\r",
              "\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\";",
              "let orderId = \"\";",
              "for (let i = 0; i < 16; i++) {",
              "    orderId += chars.charAt(Math.floor(Math.random() * chars.length));",
              "}",
              "pm.environment.set(\"orderId\", orderId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "password",
              "value": "{{apiPassword}}",
              "type": "string"
