  "item": [
    {
      "name": "Create Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json = pm.response.json();\r",
              "\r",
              "\r",
              "if (json.session && json.session.id) {\r",
              "\r",
              "    let sessionId = json.session.id;\r",
              "\r",
              "    postman.setEnvironmentVariable('sessionId', sessionId);\r",
              "\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "password",
              "value": "{{apiPassword}}",
              "type": "string"
            },
            {
              "key": "username",
              "value": "merchant.{{merchantId}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"session\": {\r\n        \"authenticationLimit\": 25\r\n    }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/session",
          "protocol": "https",
          "host": [
            "{{host}}"
          ],
          "path": [
