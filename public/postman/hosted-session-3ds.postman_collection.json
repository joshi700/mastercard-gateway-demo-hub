              "key": "username",
              "value": "merchant.{{merchantId}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"authentication\": {\r\n        \"redirectResponseUrl\": \"https://apitest.free.beeceptor.com\",\r\n        \"acceptVersions\": \"3DS1,3DS2\",\r\n        \"channel\": \"PAYER_BROWSER\",\r\n        \"purpose\": \"PAYMENT_TRANSACTION\"\r\n    },\r\n    \"device\": {\r\n        \"browser\": \"MOZILLA\",\r\n        \"browserDetails\": {\r\n            \"3DSecureChallengeWindowSize\": \"FULL_SCREEN\",\r\n            \"acceptHeaders\": \"application/json\",\r\n            \"colorDepth\": 24,\r\n            \"javaEnabled\": true,\r\n            \"language\": \"en-US\",\r\n            \"screenHeight\": 640,\r\n            \"screenWidth\": 480,\r\n            \"timeZone\": 273\r\n        },\r\n        \"ipAddress\": \"127.100.100.1\"\r\n    },\r\n    \"order\": {\r\n        \"amount\": 100.00,\r\n        \"currency\": \"USD\",\r\n        \"id\": \"{{orderId}}\",\r\n        \"reference\": \"OrderRefno1\"\r\n    }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
