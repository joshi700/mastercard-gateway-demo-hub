{
  "info": {
    "name": "Hosted Checkout \u2014 CIT / MIT",
    "description": "Cardholder-initiated (CIT) and merchant-initiated (MIT) Hosted Checkout flows on the Mastercard Gateway.\n\nSetup: import this collection and the Gateway Environment, select the environment, then set `merchantId` and `apiPassword` to your own MTF credentials. Nothing else needs editing \u2014 order, agreement and transaction ids are generated by pre-request scripts and the card token is captured automatically from the retrieve-order response.\n\nAuth is HTTP Basic (`merchant.{{merchantId}}` / `{{apiPassword}}`) set once at collection level, so no credentials are stored in this file.\n\nRun the folders in order \u2014 folders 2 and 3 depend on the token captured in folder 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "merchant.{{merchantId}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{apiPassword}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. CIT \u2014 Checkout & save the card",
      "description": "Cardholder-initiated checkout that stores the card as a credential on file. Run the requests in order: create the session, open Checkout with the returned session id, then retrieve the order to capture the card token.",
      "item": [
        {
          "name": "Initiate Checkout (save card)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/session",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "session"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiOperation\": \"INITIATE_CHECKOUT\",\n  \"interaction\": {\n    \"operation\": \"AUTHORIZE\",\n    \"merchant\": {\n      \"name\": \"{{merchantName}}\",\n      \"url\": \"{{merchantUrl}}\"\n    },\n    \"displayControl\": {\n      \"billingAddress\": \"HIDE\",\n      \"customerEmail\": \"HIDE\"\n    },\n    \"timeoutUrl\": \"{{merchantUrl}}\",\n    \"cancelUrl\": \"{{merchantUrl}}\",\n    \"returnUrl\": \"{{merchantUrl}}\",\n    \"saveCardForCredentialOnFile\": \"PAYER_INITIATED_PAYMENTS\"\n  },\n  \"order\": {\n    \"id\": \"{{orderId}}\",\n    \"amount\": \"{{amount}}\",\n    \"currency\": \"{{currency}}\",\n    \"description\": \"Cardholder-initiated payment, card saved for later use\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh order id for every run.",
                  "const hex = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join('');",
                  "pm.environment.set('orderId', `ORDER-${hex(8)}-${hex(4)}`);",
                  "console.log('orderId:', pm.environment.get('orderId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Session created', () => pm.expect(res.result).to.eql('SUCCESS'));",
                  "",
                  "if (res.session && res.session.id) {",
                  "    pm.environment.set('sessionId', res.session.id);",
                  "    console.log('Saved sessionId:', res.session.id);",
                  "}",
                  "if (res.successIndicator) {",
                  "    pm.environment.set('successIndicator', res.successIndicator);",
                  "}",
                  "",
                  "// Hand session.id to the Checkout JS (Checkout.configure) to show the payment page."
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve Order (capture token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/order/{{orderId}}",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "order",
                "{{orderId}}"
              ]
            },
            "description": "Run after the payer completes Checkout. Stores the saved-card token in {{cardToken}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "// The saved-card token can sit on the order or on one of its transactions.",
                  "let token = res.sourceOfFunds && res.sourceOfFunds.token;",
                  "if (!token && Array.isArray(res.transaction)) {",
                  "    const hit = res.transaction.find(",
                  "        (t) => t.sourceOfFunds && t.sourceOfFunds.token);",
                  "    token = hit && hit.sourceOfFunds.token;",
                  "}",
                  "",
                  "if (token) {",
                  "    pm.environment.set('cardToken', token);",
                  "    console.log('Saved cardToken:', token);",
                  "} else {",
                  "    console.warn('No token on this order \u2014 was the card saved for credential-on-file?');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/token/{{cardToken}}",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "token",
                "{{cardToken}}"
              ]
            },
            "description": "Inspect the stored credential: masked card number, expiry and token status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. CIT \u2014 Checkout with the saved token",
      "description": "Returning cardholder: pre-fill Checkout with the token captured in folder 1 so the payer confirms instead of re-entering the card.",
      "item": [
        {
          "name": "Initiate Checkout with token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/session",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "session"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiOperation\": \"INITIATE_CHECKOUT\",\n  \"interaction\": {\n    \"operation\": \"AUTHORIZE\",\n    \"merchant\": {\n      \"name\": \"{{merchantName}}\",\n      \"url\": \"{{merchantUrl}}\"\n    },\n    \"displayControl\": {\n      \"billingAddress\": \"HIDE\",\n      \"customerEmail\": \"HIDE\"\n    },\n    \"timeoutUrl\": \"{{merchantUrl}}\",\n    \"cancelUrl\": \"{{merchantUrl}}\",\n    \"returnUrl\": \"{{merchantUrl}}\",\n    \"tokens\": [\n      \"{{cardToken}}\"\n    ]\n  },\n  \"order\": {\n    \"id\": \"{{orderId}}\",\n    \"amount\": \"{{amount}}\",\n    \"currency\": \"{{currency}}\",\n    \"description\": \"Cardholder-initiated payment using a saved token\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh order id for every run.",
                  "const hex = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join('');",
                  "pm.environment.set('orderId', `ORDER-${hex(8)}-${hex(4)}`);",
                  "console.log('orderId:', pm.environment.get('orderId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Session created', () => pm.expect(res.result).to.eql('SUCCESS'));",
                  "",
                  "if (res.session && res.session.id) {",
                  "    pm.environment.set('sessionId', res.session.id);",
                  "    console.log('Saved sessionId:', res.session.id);",
                  "}",
                  "if (res.successIndicator) {",
                  "    pm.environment.set('successIndicator', res.successIndicator);",
                  "}",
                  "",
                  "// Hand session.id to the Checkout JS (Checkout.configure) to show the payment page."
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve Order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/order/{{orderId}}",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "order",
                "{{orderId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "// The saved-card token can sit on the order or on one of its transactions.",
                  "let token = res.sourceOfFunds && res.sourceOfFunds.token;",
                  "if (!token && Array.isArray(res.transaction)) {",
                  "    const hit = res.transaction.find(",
                  "        (t) => t.sourceOfFunds && t.sourceOfFunds.token);",
                  "    token = hit && hit.sourceOfFunds.token;",
                  "}",
                  "",
                  "if (token) {",
                  "    pm.environment.set('cardToken', token);",
                  "    console.log('Saved cardToken:', token);",
                  "} else {",
                  "    console.warn('No token on this order \u2014 was the card saved for credential-on-file?');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. CIT \u2192 MIT \u2014 recurring agreement",
      "description": "First payment is cardholder-initiated and establishes a recurring agreement; subsequent payments are merchant-initiated against the same agreement id and token.",
      "item": [
        {
          "name": "Initiate Checkout CIT (create agreement)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/session",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "session"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiOperation\": \"INITIATE_CHECKOUT\",\n  \"interaction\": {\n    \"operation\": \"AUTHORIZE\",\n    \"merchant\": {\n      \"name\": \"{{merchantName}}\",\n      \"url\": \"{{merchantUrl}}\"\n    },\n    \"displayControl\": {\n      \"billingAddress\": \"HIDE\",\n      \"customerEmail\": \"HIDE\"\n    },\n    \"timeoutUrl\": \"{{merchantUrl}}\",\n    \"cancelUrl\": \"{{merchantUrl}}\",\n    \"returnUrl\": \"{{merchantUrl}}\"\n  },\n  \"agreement\": {\n    \"id\": \"{{agreementId}}\",\n    \"type\": \"RECURRING\",\n    \"expiryDate\": \"{{agreementExpiryDate}}\",\n    \"amountVariability\": \"FIXED\",\n    \"minimumDaysBetweenPayments\": 29\n  },\n  \"order\": {\n    \"id\": \"{{orderId}}\",\n    \"amount\": \"{{amount}}\",\n    \"currency\": \"{{currency}}\",\n    \"description\": \"First payment of a recurring agreement\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh order id and agreement id for every run.",
                  "const hex = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join('');",
                  "pm.environment.set('orderId', `ORDER-${hex(8)}-${hex(4)}`);",
                  "pm.environment.set('agreementId', `AGREE-${hex(8)}`);",
                  "",
                  "// Agreement expiry: three years from today (YYYY-MM-DD).",
                  "const d = new Date();",
                  "d.setFullYear(d.getFullYear() + 3);",
                  "pm.environment.set('agreementExpiryDate', d.toISOString().slice(0, 10));",
                  "",
                  "console.log('orderId:', pm.environment.get('orderId'),",
                  "            '| agreementId:', pm.environment.get('agreementId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Session created', () => pm.expect(res.result).to.eql('SUCCESS'));",
                  "",
                  "if (res.session && res.session.id) {",
                  "    pm.environment.set('sessionId', res.session.id);",
                  "    console.log('Saved sessionId:', res.session.id);",
                  "}",
                  "if (res.successIndicator) {",
                  "    pm.environment.set('successIndicator', res.successIndicator);",
                  "}",
                  "",
                  "// Hand session.id to the Checkout JS (Checkout.configure) to show the payment page."
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve Order (capture token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/order/{{orderId}}",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "order",
                "{{orderId}}"
              ]
            },
            "description": "Run after the payer completes Checkout. Stores the agreement's card token in {{cardToken}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "// The saved-card token can sit on the order or on one of its transactions.",
                  "let token = res.sourceOfFunds && res.sourceOfFunds.token;",
                  "if (!token && Array.isArray(res.transaction)) {",
                  "    const hit = res.transaction.find(",
                  "        (t) => t.sourceOfFunds && t.sourceOfFunds.token);",
                  "    token = hit && hit.sourceOfFunds.token;",
                  "}",
                  "",
                  "if (token) {",
                  "    pm.environment.set('cardToken', token);",
                  "    console.log('Saved cardToken:', token);",
                  "} else {",
                  "    console.warn('No token on this order \u2014 was the card saved for credential-on-file?');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "PAY \u2014 merchant-initiated (MIT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/order/{{orderId}}/transaction/{{transactionID}}",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "order",
                "{{orderId}}",
                "transaction",
                "{{transactionID}}"
              ]
            },
            "description": "Subsequent recurring payment \u2014 no cardholder present. Re-run for each instalment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiOperation\": \"PAY\",\n  \"agreement\": {\n    \"id\": \"{{agreementId}}\",\n    \"type\": \"RECURRING\"\n  },\n  \"order\": {\n    \"amount\": \"{{amount}}\",\n    \"currency\": \"{{currency}}\"\n  },\n  \"sourceOfFunds\": {\n    \"token\": \"{{cardToken}}\"\n  },\n  \"transaction\": {\n    \"source\": \"MERCHANT\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Each merchant-initiated payment is its own order + transaction.",
                  "const hex = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join('');",
                  "pm.environment.set('orderId', `ORDER-${hex(8)}-${hex(4)}`);",
                  "pm.environment.set('transactionID', `TXN-${hex(8)}`);",
                  "",
                  "console.log('orderId:', pm.environment.get('orderId'),",
                  "            '| transactionID:', pm.environment.get('transactionID'),",
                  "            '| agreementId:', pm.environment.get('agreementId'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve Order (MIT)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{host}}/api/rest/version/{{version}}/merchant/{{merchantId}}/order/{{orderId}}",
              "protocol": "https",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "rest",
                "version",
                "{{version}}",
                "merchant",
                "{{merchantId}}",
                "order",
                "{{orderId}}"
              ]
            },
            "description": "Confirm the merchant-initiated payment."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "merchantName",
      "value": "Demo Merchant",
      "type": "string"
    },
    {
      "key": "merchantUrl",
      "value": "https://www.mastercard.com",
      "type": "string"
    },
    {
      "key": "amount",
      "value": "12.60",
      "type": "string"
    }
  ]
}
